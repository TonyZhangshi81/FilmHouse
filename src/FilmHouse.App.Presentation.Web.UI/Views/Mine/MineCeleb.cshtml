@using Microsoft.AspNetCore.Http;
@using Microsoft.AspNetCore.Http.Extensions;

@model FilmHouse.App.Presentation.Web.UI.Models.MineCelebViewModel

@{
    Layout = "~/Views/Mine/_LayoutPage.cshtml";
    if (ViewBag.CelebType == 1)
    {
        ViewBag.Title = "我收藏的影人(" + Model.DiscViewModel.CollectCount + ")";
    }
    else
    {
        ViewBag.Title = "我创建的影人(" + Model.DiscViewModel.CreateCount + ")";
    }

    var transfer = new Uri(Context.Request.GetDisplayUrl()).PathAndQuery;
}

<div class="panel panel-body">
    <ul class="nav nav-tabs">
        @if (ViewBag.CelebType == 1)
        {
            <li class="active"><a href="/Mine/MineCeleb?type=1">收藏的(@Model.DiscViewModel.CollectCount)     </a></li>
        }
        else
        {
            <li class=""><a href="/Mine/MineCeleb?type=1">收藏的(@Model.DiscViewModel.CollectCount)     </a></li>
        }
        @if (ViewBag.CelebType == 2)
        {
            <li class="active"><a href="/Mine/MineCeleb?type=2">创建的(@Model.DiscViewModel.CreateCount)     </a></li>
        }
        else
        {
            <li class=""><a href="/Mine/MineCeleb?type=2">创建的(@Model.DiscViewModel.CreateCount)     </a></li>
        }
    </ul>

    @if (ViewBag.CelebType == 2)
    {
        <div style="margin-top:10px;">
            <a class="btn btn-primary" href="/Celeb/Create/" title="新建影人" target="_self">新建影人</a>
        </div>
    }
    @if (Model.Celebs.Count == 0)
    {
        if (ViewBag.CelebType == 1)
        {
            <div class="text-center" style="margin-top:15px;">没有收藏的影人(＃￣▽￣＃)</div>
        }
        else
        {
            <div class="text-center" style="margin-top:15px;">你还没有创建过影人(＃￣▽￣＃)</div>
        }
    }
</div>



